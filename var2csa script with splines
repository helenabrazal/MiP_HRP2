safe_log1p <- function(x) {
  suppressWarnings(ifelse(is.na(x) | x < 0, NA_real_, log1p(x)))
}

## only non-aliased coefficients and the matching covariance block.
## One NA in beta makes xd %*% beta NA at every grid point, silently.
usable <- function(model) {
  if (is.null(model)) return(NULL)
  beta <- tryCatch(stats::coef(model), error = function(e) NULL)
  V    <- tryCatch(stats::vcov(model), error = function(e) NULL)
  if (is.null(beta) || is.null(V) || length(beta) == 0) return(NULL)
  
  keep <- is.finite(beta) & names(beta) %in% rownames(V)
  if (!any(keep)) return(NULL)
  
  nm <- names(beta)[keep]
  list(beta = beta[keep], V = V[nm, nm, drop = FALSE], names = nm)
}

apply_common_support <- function(df,
                                 x = "c_log_density",
                                 group_vars = c("gravidity", "centro"),
                                 probs = c(0.05, 0.95),
                                 restrict = TRUE) {
  stopifnot(x %in% names(df))
  
  rng <- df %>%
    dplyr::filter(is.finite(.data[[x]]), !is.na(.data[[x]])) %>%
    dplyr::group_by(dplyr::across(dplyr::all_of(group_vars))) %>%
    dplyr::summarise(
      q_low  = as.numeric(stats::quantile(.data[[x]], probs[1], na.rm = TRUE)),
      q_high = as.numeric(stats::quantile(.data[[x]], probs[2], na.rm = TRUE)),
      n_grp  = dplyr::n(), .groups = "drop")
  
  if (nrow(rng) < 2) {
    warning("Common support: <2 groups for ", x, "; skipping.")
    return(list(df = df, c_low = NA_real_, c_high = NA_real_, rng = rng))
  }
  
  c_low  <- suppressWarnings(max(rng$q_low,  na.rm = TRUE))
  c_high <- suppressWarnings(min(rng$q_high, na.rm = TRUE))
  
  if (!is.finite(c_low) || !is.finite(c_high) || c_low >= c_high) {
    warning("Common support empty for ", x, "; skipping.")
    return(list(df = df, c_low = c_low, c_high = c_high, rng = rng))
  }
  
  ## the bounds are returned either way: the grid uses them even when
  ## the data are not restricted
  df2 <- if (restrict)
    df %>% dplyr::filter(.data[[x]] >= c_low, .data[[x]] <= c_high) else df
  
  list(df = df2, c_low = c_low, c_high = c_high, rng = rng)
}

clean_text <- function(x) {
  if (is.null(x)) return(x)
  x <- enc2utf8(as.character(x))
  x <- gsub("ManhiÃ§a", "Manhiça", x, fixed = TRUE)
  x <- gsub("\u2013|\u2014|\u2212", "-", x)
  x <- gsub("\u00A0", " ", x, fixed = TRUE)
  x <- gsub("[[:space:]]+", " ", x)
  x <- gsub("[[:cntrl:]]", "", x)
  trimws(x)
}

