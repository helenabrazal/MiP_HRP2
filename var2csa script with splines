make_methods_within_site <- function(emm_obj,
                                     grav_var = "gravidity", centro_var = "centro",
                                     primi_lvl = "primigravidae",
                                     multi_lvl = "multigravidae") {
  emm_df <- as.data.frame(emm_obj); K <- nrow(emm_df)
  g <- as.character(emm_df[[grav_var]]); s <- as.character(emm_df[[centro_var]])
  
  methods <- list(); labels <- character(); idx <- 1L
  for (st in sort(unique(s))) {
    ip <- which(g == primi_lvl & s == st); im <- which(g == multi_lvl & s == st)
    if (!length(ip) || !length(im)) {
      warning("Site ", st, " lacks one gravidity group; contrast skipped."); next
    }
    v <- numeric(K); v[ip[1]] <- 1; v[im[1]] <- -1
    labels[idx] <- paste0("Primi - Multi, ", st); methods[[idx]] <- v; idx <- idx + 1L
  }
  if (!length(methods)) stop("No within-site contrasts could be built.")
  setNames(methods, labels)
}

make_methods_primi_vs_all_nodup <- function(emm_obj,
                                            grav_var = "gravidity", centro_var = "centro",
                                            primi_lvl = "primigravidae") {
  emm_df <- as.data.frame(emm_obj); K <- nrow(emm_df)
  key <- paste(as.character(emm_df[[grav_var]]), as.character(emm_df[[centro_var]]), sep = "||")
  idx_map <- setNames(seq_len(K), key)
  primi_centres <- sort(unique(as.character(
    emm_df[[centro_var]][as.character(emm_df[[grav_var]]) == primi_lvl])))
  
  methods <- list(); labels <- character(); idx <- 1L
  for (c1 in primi_centres) {
    a_key <- paste(primi_lvl, c1, sep = "||")
    if (!a_key %in% names(idx_map)) next
    a_idx <- idx_map[[a_key]]
    for (j in seq_len(K)) {
      if (j == a_idx) next
      g2 <- as.character(emm_df[[grav_var]][j]); c2 <- as.character(emm_df[[centro_var]][j])
      if (g2 == primi_lvl && !(c1 < c2)) next
      v <- numeric(K); v[a_idx] <- 1; v[j] <- -1
      labels[idx] <- paste0("Primi ", c1, " - ", grav_short(g2), " ", c2)
      methods[[idx]] <- v; idx <- idx + 1L
    }
  }
  if (!length(methods)) stop("No contrasts built (check levels).")
  setNames(methods, labels)
}

make_methods <- function(emm_obj) {
  if (CONTRAST_SET == "within_site") make_methods_within_site(emm_obj)
  else make_methods_primi_vs_all_nodup(emm_obj)
}

build_pairs_within_site <- function(mf_used,
                                    primi_lvl = "primigravidae",
                                    multi_lvl = "multigravidae") {
  gd <- mf_used %>% dplyr::distinct(gravidity, centro) %>%
    dplyr::mutate(gravidity = as.character(gravidity), centro = as.character(centro))
  out <- list(); k <- 1L
  for (st in sort(unique(gd$centro))) {
    if (!any(gd$gravidity == primi_lvl & gd$centro == st)) next
    if (!any(gd$gravidity == multi_lvl & gd$centro == st)) next
    out[[k]] <- data.frame(g1 = primi_lvl, c1 = st, g2 = multi_lvl, c2 = st,
                           contrast = paste0("Primi - Multi, ", st),
                           stringsAsFactors = FALSE)
    k <- k + 1L
  }
  if (!length(out)) return(data.frame())
  dplyr::bind_rows(out) %>% dplyr::distinct(contrast, .keep_all = TRUE)
}

build_pairs_primi_vs_all <- function(mf_used, primi_lvl = "primigravidae") {
  gd <- mf_used %>% dplyr::distinct(gravidity, centro) %>%
    dplyr::mutate(gravidity = as.character(gravidity), centro = as.character(centro))
  primi_centres <- sort(unique(gd$centro[gd$gravidity == primi_lvl]))
  out <- list(); k <- 1L
  for (c1 in primi_centres) for (i in seq_len(nrow(gd))) {
    g2 <- gd$gravidity[i]; c2 <- gd$centro[i]
    if (g2 == primi_lvl && c2 == c1) next
    if (g2 == primi_lvl && !(c1 < c2)) next
    out[[k]] <- data.frame(g1 = primi_lvl, c1 = c1, g2 = g2, c2 = c2,
                           contrast = paste0("Primi ", c1, " - ", grav_short(g2), " ", c2),
                           stringsAsFactors = FALSE)
    k <- k + 1L
  }
  if (!length(out)) return(data.frame())
  dplyr::bind_rows(out) %>% dplyr::distinct(contrast, .keep_all = TRUE)
}

build_pairs <- function(mf_used) {
  if (CONTRAST_SET == "within_site") build_pairs_within_site(mf_used)
  else build_pairs_primi_vs_all(mf_used)
}

tidy_contrasts <- function(pw_sidak, pw_raw, label) {
  as.data.frame(summary(pw_sidak, infer = c(TRUE, TRUE))) %>%
    dplyr::rename(p_sidak = p.value) %>%
    dplyr::left_join(
      as.data.frame(summary(pw_raw)) %>%
        dplyr::select(contrast, p.value) %>% dplyr::rename(p_raw = p.value),
      by = "contrast") %>%
    dplyr::mutate(model = label)
}

fmt_p <- function(p, lbl) {
  base <- ifelse(is.na(p), paste0(lbl, " p = NA"), sprintf("%s p = %.3f", lbl, p))
  ifelse(!is.na(p) & p < 0.05, paste0("<b>", base, "</b>"), base)
}

## ============================================================
## 3) Interaction screening, as in the antigen scripts
##
## The predictor x gravidity x site term is retained a priori: it is
## the primary hypothesis and must be reported whatever its p-value.
## HIV and gestational age enter only when supported, because they
## are secondary objectives: they say whether the antibody-antigen
## relationship itself shifts with those variables.
## ============================================================
lrt_lm <- function(reduced, full, label) {
  a <- anova(reduced, full)
  data.frame(
    interaction = label,
    df_difference = abs(diff(a$Df[1:2])),
    F_statistic = a$F[2],
    p_value = a$`Pr(>F)`[2],
    significant_0.05 = !is.na(a$`Pr(>F)`[2]) & a$`Pr(>F)`[2] < 0.05,
    stringsAsFactors = FALSE)
}

screen_interactions <- function(df, outcome_var, pred, covar_str, tag) {
  f <- function(rhs) lm(as.formula(paste0(outcome_var, " ~ ", rhs)), data = df)
  
  base <- paste(pred, covar_str, sep = " + ")
  
  rows <- list()
  
  ## HIV x predictor
  if ("hiv" %in% names(df)) {
    r <- f(paste(base, "hiv", sep = " + "))
    u <- f(paste(base, paste0(pred, ":hiv"), "hiv", sep = " + "))
    rows[[length(rows) + 1]] <- lrt_lm(r, u, "HIV x predictor")
  }
  
  ## gestweeks x predictor
  if ("gestweeks" %in% names(df)) {
    r <- f(base)
    u <- f(paste(base, paste0(pred, ":gestweeks"), sep = " + "))
    rows[[length(rows) + 1]] <- lrt_lm(r, u, "Gestational weeks x predictor")
  }
  
  ## predictor x gravidity x site, tested against all two-way terms
  r <- f(paste(base,
               paste0(pred, ":gravidity"), paste0(pred, ":centro"),
               "gravidity * centro", sep = " + "))
  u <- f(paste(base, paste0(pred, " * gravidity * centro"), sep = " + "))
  rows[[length(rows) + 1]] <- lrt_lm(r, u, "Predictor x gravidity x site")
  
  dplyr::bind_rows(rows) %>% dplyr::mutate(model = tag, .before = 1)
}

## ============================================================
## 4) Simultaneous-band machinery
## ============================================================
make_newdata_fixed <- function(model, grav, cent, c_var_name, c_value) {
  ## built from the ORIGINAL variables in the formula, not from
  ## model.frame() names, so that ns(predictor, df) is re-evaluated
  ## by model.matrix() using the knots stored in the terms object
  mf <- model.frame(model)
  tt <- delete.response(stats::terms(model))
  required_vars <- all.vars(tt)
  
  if (!c_var_name %in% required_vars)
    stop("Model formula does not contain predictor: ", c_var_name)
  
  nd <- as.data.frame(matrix(NA, nrow = 1, ncol = length(required_vars)),
                      stringsAsFactors = FALSE)
  names(nd) <- required_vars
  
  nd[[c_var_name]] <- c_value
  if ("gravidity" %in% names(nd)) nd$gravidity <- grav
  if ("centro"    %in% names(nd)) nd$centro    <- cent
  
  for (nm in names(nd)) {
    if (nm %in% c(c_var_name, "gravidity", "centro")) next
    
    src <- if (nm %in% names(mf)) mf[[nm]]
    else if (nm %in% names(data_base)) data_base[[nm]]
    else stop("Cannot construct newdata: variable '", nm, "' not available.")
    
    nd[[nm]] <- if (is.factor(src)) names(which.max(table(src)))
    else if (is.numeric(src) || is.integer(src)) mean(src, na.rm = TRUE)
    else src[which(!is.na(src))[1]]
  }
  
  xlev <- model$xlevels
  if (!is.null(xlev))
    for (nm in intersect(names(xlev), names(nd)))
      nd[[nm]] <- factor(nd[[nm]], levels = xlev[[nm]])
  
  nd
}

contrast_curve_exact <- function(model, raw_grid, mu_log_raw, c_var_name,
                                 g1, c1, g2, c2, alpha = 0.05,
                                 nsim = NSIM_BAND, seed = SEED_BAND) {
  
  ## ------------------------------------------------------------
  ## SIMULTANEOUS 95% CONFIDENCE BAND
  ##
  ## Coefficient vectors are drawn from N(beta_hat, V_hat); for each
  ## draw we take the largest absolute standardized deviation over
  ## the WHOLE curve, and the 95th percentile of those maxima is the
  ## critical value. This controls the family-wise error rate along
  ## the predictor axis while preserving the correlation between
  ## neighbouring points, which a Bonferroni correction over 200
  ## grid points would ignore. Reviewer point 5.
  ## ------------------------------------------------------------
  
  u <- usable(model)
  
  if (is.null(u)) {
    out <- data.frame(x_raw = raw_grid, diff = NA_real_, se = NA_real_,
                      lower = NA_real_, upper = NA_real_,
                      sig_pos = FALSE, sig_neg = FALSE)
    return(list(curve = out, summary = data.frame(
      seg_pos = NA_character_, seg_neg = NA_character_,
      x_min_used = min(raw_grid), x_max_used = max(raw_grid),
      n_grid = length(raw_grid), simultaneous_critical = NA_real_,
      confidence_level = 1 - alpha, nsim = nsim,
      note = "No usable non-aliased coefficients available.")))
  }
  
  tt_noy <- delete.response(terms(model))
  
  Xdiff <- matrix(NA_real_, nrow = length(raw_grid), ncol = length(u$names),
                  dimnames = list(NULL, u$names))
  
  for (i in seq_along(raw_grid)) {
    ## log1p here, to match how the centred predictors were built
    xc <- log1p(raw_grid[i]) - mu_log_raw
    
    nd1 <- make_newdata_fixed(model, g1, c1, c_var_name, xc)
    nd2 <- make_newdata_fixed(model, g2, c2, c_var_name, xc)
    
    X1 <- tryCatch(model.matrix(tt_noy, nd1), error = function(e) NULL)
    X2 <- tryCatch(model.matrix(tt_noy, nd2), error = function(e) NULL)
    if (is.null(X1) || is.null(X2)) next
    if (!all(u$names %in% colnames(X1)) || !all(u$names %in% colnames(X2))) next
    
    Xdiff[i, ] <- X1[, u$names, drop = FALSE] - X2[, u$names, drop = FALSE]
  }
  
  valid <- apply(Xdiff, 1, function(z) all(is.finite(z)))
  if (!any(valid)) stop("No valid design rows for the simultaneous band.")
  
  Xv <- Xdiff[valid, , drop = FALSE]
  x_grid_valid <- raw_grid[valid]
  
  diff_hat <- as.numeric(Xv %*% u$beta)
  se_diff  <- sqrt(pmax(0, rowSums((Xv %*% u$V) * Xv)))
  
  se_ok <- is.finite(se_diff) & se_diff > 0
  if (!any(se_ok)) stop("No positive finite standard errors for the band.")
  
  set.seed(seed)
  beta_sim <- MASS::mvrnorm(n = nsim, mu = u$beta, Sigma = u$V, empirical = FALSE)
  
  sim_diff <- beta_sim %*% t(Xv)
  z_sim <- sweep(sweep(sim_diff, 2, diff_hat, "-"), 2, se_diff, "/")
  z_sim <- z_sim[, se_ok, drop = FALSE]
  
  crit <- as.numeric(stats::quantile(apply(abs(z_sim), 1, max, na.rm = TRUE),
                                     probs = 1 - alpha, na.rm = TRUE, names = FALSE))
  
  out <- data.frame(x_raw = x_grid_valid, diff = diff_hat, se = se_diff,
                    lower = diff_hat - crit * se_diff,
                    upper = diff_hat + crit * se_diff) %>%
    dplyr::mutate(sig_pos = is.finite(lower) & lower > 0,
                  sig_neg = is.finite(upper) & upper < 0)
  
  list(curve = out,
       summary = data.frame(
         seg_pos = segments_to_string(find_segments(out$x_raw, out$sig_pos)),
         seg_neg = segments_to_string(find_segments(out$x_raw, out$sig_neg)),
         x_min_used = min(out$x_raw), x_max_used = max(out$x_raw),
         n_grid = nrow(out), simultaneous_critical = crit,
         confidence_level = 1 - alpha, nsim = nsim,
         note = "Simultaneous band from parametric MVN coefficient simulation."))
}

make_shade_boundary_labels <- function(df_one, unit_suffix) {
  df <- df_one
  if (!nrow(df)) return(NULL)
  sp <- df$sig_pos; sp[is.na(sp)] <- FALSE
  sn <- df$sig_neg; sn[is.na(sn)] <- FALSE
  seg_pos <- find_segments(df$x_raw, sp); seg_neg <- find_segments(df$x_raw, sn)
  
  ymin <- min(c(df$lower, df$diff, 0), na.rm = TRUE)
  ymax <- max(c(df$upper, df$diff, 0), na.rm = TRUE)
  span <- if (is.finite(ymax - ymin) && (ymax - ymin) > 0) (ymax - ymin) else 1
  step <- 0.14 * span
  labfun <- scales::label_number(accuracy = 0.01, big.mark = ",")
  
  bl <- function(seg, y_base, down) {
    if (!nrow(seg)) return(NULL)
    dplyr::bind_rows(data.frame(x_raw = seg$start), data.frame(x_raw = seg$end)) %>%
      dplyr::distinct(x_raw) %>% dplyr::arrange(x_raw) %>%
      dplyr::mutate(idx = dplyr::row_number(),
                    y = if (down) y_base - (idx - 1) * step else y_base + (idx - 1) * step,
                    y = pmin(pmax(y, ymin + 0.03 * span), ymax - 0.03 * span),
                    label = paste0(labfun(x_raw), "\n", unit_suffix), hjust = 0.5) %>%
      dplyr::select(x_raw, y, label, hjust)
  }
  
  out <- dplyr::bind_rows(bl(seg_pos, ymax - 0.08 * span, TRUE),
                          bl(seg_neg, ymin + 0.08 * span, FALSE))
  if (is.null(out) || !nrow(out)) return(NULL)
  out %>% dplyr::mutate(contrast = df$contrast[1]) %>%
    dplyr::select(contrast, x_raw, y, label, hjust)
}

plot_contrast_curves <- function(curves_df, labels_df, title_txt, colour_hex,
                                 x_label, y_label_txt) {
  if (is.null(labels_df) || !nrow(labels_df) || !("contrast" %in% names(labels_df))) {
    vlines_df <- data.frame(contrast = character(0), x_raw = numeric(0))
    labels_df <- data.frame(contrast = character(0), x_raw = numeric(0),
                            y = numeric(0), label = character(0), hjust = numeric(0))
  } else {
    vlines_df <- labels_df %>% dplyr::distinct(contrast, x_raw)
  }
  
  ggplot(curves_df, aes(x = x_raw)) +
    geom_ribbon(aes(ymin = lower, ymax = upper), fill = colour_hex, alpha = 0.18, colour = NA) +
    geom_ribbon(data = curves_df %>% dplyr::filter(sig_pos),
                aes(ymin = lower, ymax = upper), fill = colour_hex, alpha = 0.30, colour = NA) +
    geom_ribbon(data = curves_df %>% dplyr::filter(sig_neg),
                aes(ymin = lower, ymax = upper), fill = colour_hex, alpha = 0.30, colour = NA) +
    geom_line(aes(y = diff), colour = colour_hex, linewidth = 1.0) +
    geom_hline(yintercept = 0, linetype = "dashed", linewidth = 0.6) +
    geom_vline(data = vlines_df, aes(xintercept = x_raw), inherit.aes = FALSE,
               linetype = "dotted", linewidth = 0.5, colour = "black", alpha = 0.65) +
    geom_text(data = labels_df, aes(x = x_raw, y = y, label = label, hjust = hjust),
              inherit.aes = FALSE, size = 4.2, vjust = 0.5, color = "black",
              lineheight = 0.95) +
    scale_x_log10(labels = scales::label_number(accuracy = 0.01, big.mark = ",")) +
    labs(title = title_txt, x = x_label, y = y_label_txt) +
    theme_classic(base_size = 14) +
    theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
          panel.border = element_rect(colour = "black", fill = NA, linewidth = 0.7),
          strip.background = element_rect(fill = "white", colour = "black", linewidth = 0.7),
          strip.text = element_text(face = "bold", size = 13, color = "black"),
          plot.title = element_text(face = "bold", size = 15, color = "black"),
          axis.title = element_text(size = 14, color = "black"),
          axis.text = element_text(size = 12, color = "black"),
          plot.margin = margin(10, 12, 10, 10))
}

safe_ggsave <- function(filename, plot, width, height, dpi = NULL, device = NULL) {
  args <- list(filename = filename, plot = plot, width = width, height = height)
  if (!is.null(dpi)) args$dpi <- dpi
  if (!is.null(device)) args$device <- device
  ok <- tryCatch({ do.call(ggplot2::ggsave, args); TRUE },
                 error = function(e) { message("Could not save '", filename, "': ",
                                               conditionMessage(e)); FALSE })
  if (ok) return(filename)
  stem <- tools::file_path_sans_ext(filename); ext <- tools::file_ext(filename)
  fallback <- paste0(stem, "_", format(Sys.time(), "%Y%m%d_%H%M%S"), ".", ext)
  ok2 <- tryCatch({ do.call(ggplot2::ggsave,
                            modifyList(args, list(filename = fallback))); TRUE },
                  error = function(e) FALSE)
  if (ok2) { message("Saved fallback: ", fallback); return(fallback) }
  NA_character_
}

run_hasta_desde <- function(model_obj, predictor_tag, c_var_name, mu_log_raw,
                            c_low, c_high, unit_suffix, colour_hex, file_stub) {
  
  cat("\n======== Predictor ranges where the SIMULTANEOUS 95% band",
      "excludes zero:", predictor_tag, "========\n")
  
  mf_used <- model.frame(model_obj)
  
  if (is.finite(c_low) && is.finite(c_high) && c_low < c_high) {
    x_min <- pmax(exp(c_low  + mu_log_raw) - 1, 1e-8)
    x_max <- pmax(exp(c_high + mu_log_raw) - 1, 1e-8)
  } else {
    xc <- suppressWarnings(as.numeric(mf_used[[c_var_name]]))
    xc <- xc[is.finite(xc)]
    if (length(xc) < 20) { cat("Too few finite values; skipping.\n"); return(invisible(NULL)) }
    xr <- pmax(exp(xc + mu_log_raw) - 1, 1e-8)
    x_min <- as.numeric(quantile(xr, .01)); x_max <- as.numeric(quantile(xr, .99))
  }
  
  if (!is.finite(x_min) || !is.finite(x_max) || x_min >= x_max) {
    cat("Invalid grid bounds; skipping.\n"); return(invisible(NULL))
  }
  
  x_grid <- exp(seq(log(x_min), log(x_max), length.out = 200))
  
  pairs_df <- build_pairs(mf_used)
  if (!nrow(pairs_df)) { cat("No contrasts available; skipping.\n"); return(invisible(NULL)) }
  pairs_df$contrast <- clean_text(pairs_df$contrast)
  
  cat("Grid:", signif(min(x_grid), 4), "to", signif(max(x_grid), 4), "(n=200)\n")
  cat("Contrasts:", nrow(pairs_df), " | set:", CONTRAST_SET, "\n")
  
  res_list <- lapply(seq_len(nrow(pairs_df)), function(ii) {
    rr <- contrast_curve_exact(model_obj, x_grid, mu_log_raw, c_var_name,
                               pairs_df$g1[ii], pairs_df$c1[ii],
                               pairs_df$g2[ii], pairs_df$c2[ii])
    list(curve   = rr$curve   %>% dplyr::mutate(contrast = pairs_df$contrast[ii]),
         summary = rr$summary %>% dplyr::mutate(contrast = pairs_df$contrast[ii]))
  })
  
  curves_all <- dplyr::bind_rows(lapply(res_list, `[[`, "curve"))
  summ_all   <- dplyr::bind_rows(lapply(res_list, `[[`, "summary"))
  
  n_fin <- sum(is.finite(curves_all$diff))
  cat("Finite contrast values:", n_fin, "of", nrow(curves_all), "\n")
  if (n_fin == 0) { warning("All contrasts NA for ", predictor_tag); return(invisible(NULL)) }
  
  curves_all <- curves_all %>% dplyr::mutate(contrast = clean_text(contrast))
  summ_all   <- summ_all %>% dplyr::mutate(contrast = clean_text(contrast),
                                           seg_pos = clean_text(seg_pos),
                                           seg_neg = clean_text(seg_neg))
  
  cf <- paste0("CURVES_", file_stub, "_", predictor_tag, "_SIMULTANEOUS95CI.csv")
  sf <- paste0("SUMMARY_", file_stub, "_", predictor_tag, "_SIMULTANEOUS95CI.csv")
  write_csv_utf8_bom(curves_all, cf)
  write_csv_utf8_bom(summ_all,   sf)
  cat("Saved:\n  -", cf, "\n  -", sf, "\n")
  
  labels_all <- dplyr::bind_rows(
    lapply(split(curves_all, curves_all$contrast),
           make_shade_boundary_labels, unit_suffix = unit_suffix))
  
  ## with no significant segment anywhere, bind_rows of NULLs gives a
  ## 0 x 0 tibble and the plot code would fail on a missing column
  if (is.null(labels_all) || !nrow(labels_all) || !("contrast" %in% names(labels_all)))
    labels_all <- data.frame(contrast = character(0), x_raw = numeric(0),
                             y = numeric(0), label = character(0), hjust = numeric(0))
  
  cat("\n---- Ranges where the simultaneous band excludes zero ----\n")
  print(as.data.frame(summ_all %>%
                        dplyr::select(contrast, seg_pos, seg_neg, simultaneous_critical)))
  cat("\nsimultaneous_critical replaces 1.96 and is larger, because the\n")
  cat("band must hold across all 200 points at once (point 5).\n")
  
  ## keep the figure readable: with 12 contrasts only those involving
  ## the key centre are drawn, which is what the original script did
  keep <- if (CONTRAST_SET == "within_site" || is.na(KEY_CENTRE))
    rep(TRUE, nrow(curves_all)) else
      grepl(KEY_CENTRE, curves_all$contrast, fixed = TRUE)
  
  if (!any(keep)) {
    warning("No contrast matched KEY_CENTRE; plotting all of them.")
    keep <- rep(TRUE, nrow(curves_all))
  }
  
  curves_plot <- curves_all[keep, , drop = FALSE] %>%
    dplyr::mutate(contrast = factor(contrast, levels = sort(unique(contrast))))
  
  cat("Contrasts plotted:", nlevels(curves_plot$contrast),
      "of", dplyr::n_distinct(curves_all$contrast), "\n")
  
  labels_plot <- if (nrow(labels_all))
    labels_all %>%
    dplyr::filter(contrast %in% levels(curves_plot$contrast)) %>%
    dplyr::mutate(contrast = factor(contrast,
                                    levels = levels(curves_plot$contrast))) else NULL
  
  ## predictor_tag carries a "_spline" suffix in the spline pass, so
  ## strip it before using it to pick a label. Without this, switch()
  ## falls through to its default and every spline figure is labelled
  ## as qPCR density whatever is actually on the x axis.
  is_spline  <- grepl("_spline$", predictor_tag)
  pred_clean <- sub("_spline$", "", predictor_tag)
  
  xlab <- switch(pred_clean,
                 HRP2  = "HRP2 (pg/mL; log scale)",
                 PfLDH = "PfLDH (pg/mL; log scale)",
                 "qPCR parasite density (parasites/µL; log scale)")
  
  pred_label <- switch(pred_clean,
                       HRP2  = "HRP2",
                       PfLDH = "PfLDH",
                       "qPCR parasite density")
  
  ## Name the outcome in the title. The colour already encodes it,
  ## amber wherever VAR2CSA is the outcome and purple wherever
  ## cumulative blood-stage IgG is, but six of these figures are
  ## written per run and "antibody level" alone does not say which
  ## antibody is on the y axis.
  outcome_name <- if (grepl("pregnancy", file_stub, fixed = TRUE))
    "VAR2CSA-specific IgG" else "Cumulative blood-stage IgG"
  
  n_panels <- nlevels(curves_plot$contrast)
  ncol_f <- if (CONTRAST_SET == "within_site") 3 else if (n_panels > 8) 3 else 2
  
  p <- plot_contrast_curves(
    curves_plot, labels_plot,
    title_txt = paste0(outcome_name, " by ", pred_label,
                       if (is_spline) " (cubic spline)" else "",
                       if (CONTRAST_SET == "within_site")
                         "\nPrimigravidae vs multigravidae within each site, simultaneous 95% band"
                       else
                         "\nPrimigravidae vs every other group, simultaneous 95% band"),
    colour_hex = colour_hex, x_label = xlab,
    y_label_txt = paste0("Difference in ", outcome_name, " (model scale)")) +
    facet_wrap(~ contrast, ncol = ncol_f, scales = "free_y")
  
  print(p)
  
  w <- if (CONTRAST_SET == "within_site") 15 else if (n_panels > 8) 15 else 11
  h <- if (CONTRAST_SET == "within_site") 5.5 else if (n_panels > 8) 13 else 10
  safe_ggsave(paste0("HASTA_DESDE_", file_stub, "_", predictor_tag,
                     "_SIMULTANEOUS95CI.png"), p, width = w, height = h, dpi = 700)
  safe_ggsave(paste0("HASTA_DESDE_", file_stub, "_", predictor_tag,
                     "_SIMULTANEOUS95CI.pdf"), p, width = w, height = h,
              device = grDevices::cairo_pdf)
  
  invisible(list(curves = curves_all, summary = summ_all, labels = labels_all, plot = p))
}

## ============================================================
## 5) Runner per outcome
## ============================================================
run_antibody_suite <- function(outcome_var, outcome_label, file_stub) {
  
  cat("\n\n============================================================\n")
  cat("OUTCOME:", outcome_label, "(", outcome_var, ")\n")
  cat("============================================================\n")
  
  covars_all <- c("Season", "Period", "gestweeks", "age_group",
                  "vector_control", "sede", "hiv")
  
  ## The colour identifies the OUTCOME, not the predictor. In the
  ## combined figure the antigen panels are the ones explained by
  ## density, and the antibody panels are a different kind of
  ## outcome; giving all three predictors of one antibody the same
  ## colour is what makes that readable at a glance.
  ## The colour identifies the OUTCOME, not the predictor: amber
  ## wherever VAR2CSA is the outcome and purple wherever cumulative
  ## IgG is, whichever biomarker is on the x axis.
  out_col <- if (outcome_var == "antibody_pregnancy") ambar else morado
  
  specs <- list(
    list(tag = "qPCRdensity", pred = "c_log_density", df = data_den,
         cs = cs_den,  mu = MU_LOG_DENS, unit = "parasites/µL", col = out_col),
    list(tag = "HRP2",        pred = "c_log_pfhrp2",  df = data_hrp2,
         cs = cs_hrp2, mu = MU_LOG_HRP2, unit = "pg/mL",        col = out_col),
    list(tag = "PfLDH",       pred = "c_log_pfldh",   df = data_ldh,
         cs = cs_ldh,  mu = MU_LOG_LDH,  unit = "pg/mL",        col = out_col)
  )
  
  screening <- list(); models <- list(); models_spline <- list()
  levels_all <- list(); slopes_all <- list(); fitcmp <- list()
  
  for (s in specs) {
    df <- s$df; pred <- s$pred
    covars <- covars_all[covars_all %in% names(df)]
    covar_str <- if (length(covars)) paste(covars, collapse = " + ") else "1"
    
    ## ---- screening ----
    sc <- screen_interactions(df, outcome_var, pred, covar_str, s$tag)
    screening[[s$tag]] <- sc
    cat("\n---- Interaction screening:", s$tag, "----\n")
    print(sc)
    
    add_hiv <- isTRUE(sc$significant_0.05[sc$interaction == "HIV x predictor"])
    add_gw  <- isTRUE(sc$significant_0.05[sc$interaction == "Gestational weeks x predictor"])
    
    extra <- c(if (add_hiv) paste0(pred, " * hiv") else NULL,
               if (add_gw)  paste0(pred, " * gestweeks") else NULL)
    
    ## the three-way term is always in
    rhs_lin <- paste(c(paste0(pred, " * gravidity * centro"), extra, covar_str),
                     collapse = " + ")
    m_lin <- lm(as.formula(paste0(outcome_var, " ~ ", rhs_lin)), data = df)
    
    ## ---- spline refit of the same structure ----
    sp <- paste0("splines::ns(", pred, ", df = ", SPLINE_DF, ")")
    extra_sp <- c(if (add_hiv) paste0(sp, " * hiv") else NULL,
                  if (add_gw)  paste0(sp, " * gestweeks") else NULL)
    rhs_sp <- paste(c(paste0(sp, " * gravidity * centro"), extra_sp, covar_str),
                    collapse = " + ")
    m_sp <- lm(as.formula(paste0(outcome_var, " ~ ", rhs_sp)), data = df)
    
    models[[s$tag]] <- m_lin
    models_spline[[s$tag]] <- m_sp
    
    fitcmp[[s$tag]] <- data.frame(
      outcome = outcome_label, predictor = s$tag,
      n = nobs(m_lin),
      hiv_included = add_hiv, gestweeks_included = add_gw,
      AIC_linear = AIC(m_lin), AIC_spline = AIC(m_sp),
      dAIC = AIC(m_sp) - AIC(m_lin),
      p_spline_vs_linear = tryCatch(anova(m_lin, m_sp)$`Pr(>F)`[2],
                                    error = function(e) NA_real_),
      stringsAsFactors = FALSE) %>%
      dplyr::mutate(prefers = ifelse(dAIC < 0, "spline", "linear"))
    
    ## ---- levels at the centring point, and slopes ----
    emm <- emmeans(m_lin, ~ gravidity * centro, at = setNames(list(0), pred))
    meth <- make_methods(emm)
    levels_all[[s$tag]] <- tidy_contrasts(
      contrast(emm, method = meth, adjust = "sidak"),
      contrast(emm, method = meth, adjust = "none"),
      paste(outcome_label, "|", s$tag, "level")) %>%
      dplyr::mutate(predictor = s$tag, outcome = outcome_label)
    
    tr <- emtrends(m_lin, specs = ~ gravidity * centro, var = pred)
    meth_s <- make_methods(tr)
    slopes_all[[s$tag]] <- tidy_contrasts(
      contrast(tr, method = meth_s, adjust = "sidak"),
      contrast(tr, method = meth_s, adjust = "none"),
      paste(outcome_label, "|", s$tag, "slope")) %>%
      dplyr::mutate(predictor = s$tag, outcome = outcome_label)
  }
  
  screening_df <- dplyr::bind_rows(screening) %>%
    dplyr::mutate(outcome = outcome_label, .before = 1)
  fitcmp_df <- dplyr::bind_rows(fitcmp)
  levels_df <- dplyr::bind_rows(levels_all)
  slopes_df <- dplyr::bind_rows(slopes_all)
  
  ## ---- model coefficients, one row per term ----
  ## Needed for the supplementary tables. Without this the
  ## coefficient tables for the antibody models cannot be built.
  coefs <- dplyr::bind_rows(lapply(names(models), function(tg) {
    broom::tidy(models[[tg]]) %>%
      dplyr::mutate(predictor = tg,
                    outcome   = outcome_label,
                    AIC       = AIC(models[[tg]]),
                    n         = nobs(models[[tg]]))
  }))
  write.csv(coefs, paste0("MODEL_COEFFICIENTS_", file_stub, ".csv"),
            row.names = FALSE)
  
