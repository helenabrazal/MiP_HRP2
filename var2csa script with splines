                                               values_from = c(seg_pos, seg_neg)) %>%
                            dplyr::filter(!(seg_pos_linear == "none" & seg_pos_spline == "none" &
                                              seg_neg_linear == "none" & seg_neg_spline == "none"))))
      cat("\nRows where the two forms disagree are the ones to look at.\n")
      cat("If the table is empty, neither form found any range, which\n")
      cat("is itself a clean answer to points 5 and 6.\n")
    }
  }
  
  invisible(list(models = models, models_spline = models_spline,
