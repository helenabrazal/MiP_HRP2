grav_short <- function(g) {
  g <- as.character(g)
  ifelse(g == "primigravidae", "Primi",
         ifelse(g == "multigravidae", "Multi", g))
}

find_segments <- function(x, flag) {
  flag <- as.logical(flag); flag[is.na(flag)] <- FALSE
  if (!any(flag)) return(data.frame(start = numeric(0), end = numeric(0)))
  r <- rle(flag); e <- cumsum(r$lengths); s <- e - r$lengths + 1; k <- which(r$values)
  data.frame(start = x[s[k]], end = x[e[k]])
}

segments_to_string <- function(seg)
  if (!nrow(seg)) "none" else paste(sprintf("%g-%g", seg$start, seg$end), collapse = "; ")

