  ## spline curve shows a pattern the linear one cannot, that is the
  ## answer to reviewer point 6; if the two agree, the linear form
  ## was adequate.
  hasta <- NULL
  hasta_spline <- NULL
  
  ## Run for BOTH antibody outcomes. Previously this was restricted
  ## to VAR2CSA, which left cumulative blood-stage IgG without the
  ## figure showing where along the predictor the groups differ.
  ## That outcome is the comparison against immunity which is not
  ## placenta-specific, and the comparison cannot be judged without
