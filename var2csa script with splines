                      paste0(file_stub, "_linear"))
    })
    names(hasta) <- vapply(specs, function(s) s$tag, character(1))
    
    cat("\n============================================================\n")
    cat("HASTA/DESDE, CUBIC-SPLINE MODELS\n")
    cat("============================================================\n")
    
    hasta_spline <- lapply(specs, function(s) {
      run_hasta_desde(models_spline[[s$tag]],
                      paste0(s$tag, "_spline"), s$pred, s$mu,
                      s$cs$c_low, s$cs$c_high, s$unit, s$col,
                      paste0(file_stub, "_spline"))
    })
    names(hasta_spline) <- vapply(specs, function(s) s$tag, character(1))
    
    ## ---- do the two forms agree on where the difference is? ----
    seg_of <- function(h, form) {
      if (is.null(h)) return(NULL)
      dplyr::bind_rows(lapply(names(h), function(tg) {
        x <- h[[tg]]
        if (is.null(x)) return(NULL)
        x$summary %>%
          dplyr::mutate(predictor = tg, form = form) %>%
          dplyr::select(predictor, form, contrast, seg_pos, seg_neg,
                        simultaneous_critical)
      }))
    }
    
    agree <- dplyr::bind_rows(seg_of(hasta, "linear"),
                              seg_of(hasta_spline, "spline"))
    
    if (nrow(agree)) {
      write.csv(agree, paste0("HASTA_DESDE_linear_vs_spline_ranges_",
                              file_stub, ".csv"), row.names = FALSE)
      cat("\n---- Significant ranges: linear vs spline ----\n")
