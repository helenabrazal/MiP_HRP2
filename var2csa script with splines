trapz <- function(x, y) {
  ok <- is.finite(x) & is.finite(y); x <- x[ok]; y <- y[ok]
  if (length(x) < 2) return(NA_real_)
  o <- order(x); x <- x[o]; y <- y[o]
  sum((y[-1] + y[-length(y)]) / 2 * diff(x))
}

add_segment_id <- function(flag) {
  flag <- as.logical(flag); flag[is.na(flag)] <- FALSE
  r <- rle(flag); seg <- rep(NA_integer_, length(flag))
  e <- cumsum(r$lengths); s <- e - r$lengths + 1; k <- 0L
  for (i in seq_along(r$values)) if (isTRUE(r$values[i])) { k <- k + 1L; seg[s[i]:e[i]] <- k }
  seg
}

summarise_magnitude <- function(curves_df, predictor_tag) {
  if (is.null(curves_df) || !nrow(curves_df)) return(tibble::tibble())
  
  df <- curves_df %>%
    dplyr::mutate(predictor = predictor_tag, contrast = clean_text(contrast),
                  x_raw = as.numeric(x_raw), diff = as.numeric(diff),
                  sig_pos = as.logical(sig_pos), sig_neg = as.logical(sig_neg)) %>%
    dplyr::filter(is.finite(x_raw), x_raw > 0) %>%
    dplyr::arrange(contrast, x_raw)
  if (!nrow(df)) return(tibble::tibble())
  
  one <- function(dsub, key, flag_col, dir) {
    dsub <- dsub %>% dplyr::arrange(x_raw) %>%
      dplyr::mutate(flag = as.logical(.data[[flag_col]]), log10x = log10(x_raw))
    dsub$flag[is.na(dsub$flag)] <- FALSE
    if (!any(dsub$flag)) return(tibble::tibble())
    dsub <- dsub %>% dplyr::mutate(seg_id = add_segment_id(flag))
    
    core <- function(d) {
      w <- max(d$log10x) - min(d$log10x)
      tibble::tibble(n_points = nrow(d), x_min = min(d$x_raw), x_max = max(d$x_raw),
                     log10_range = w,
                     mean_diff = mean(d$diff), median_diff = stats::median(d$diff),
                     avg_diff_per_log10 = if (is.finite(w) && w > 0)
                       trapz(d$log10x, d$diff)/w else NA_real_)
    }
    
    overall <- dsub %>% dplyr::filter(flag) %>% core() %>%
      dplyr::mutate(predictor = predictor_tag, contrast = key, direction = dir,
                    level = "overall", seg_id = NA_integer_)
    segs <- dsub %>% dplyr::filter(!is.na(seg_id)) %>% split(.$seg_id) %>%
      lapply(function(d) core(d) %>% dplyr::mutate(seg_id = d$seg_id[1])) %>%
      dplyr::bind_rows()
    if (nrow(segs)) segs <- segs %>%
      dplyr::mutate(predictor = predictor_tag, contrast = key,
                    direction = dir, level = "segment")
    dplyr::bind_rows(overall, segs)
  }
  
  spl <- split(df, df$contrast, drop = TRUE)
  res <- lapply(names(spl), function(cc)
    dplyr::bind_rows(one(spl[[cc]], cc, "sig_pos", "sig_pos"),
                     one(spl[[cc]], cc, "sig_neg", "sig_neg"))) %>%
    dplyr::bind_rows()
  
  if (!nrow(res) || !("predictor" %in% names(res))) {
    cat("  (", predictor_tag, ": no significant interval)\n", sep = "")
    return(tibble::tibble())
  }
  
  res %>% dplyr::select(predictor, contrast, direction, level, seg_id, dplyr::everything())
}

collect_mag <- function(h, form) {
  if (is.null(h)) return(tibble::tibble())
  dplyr::bind_rows(lapply(names(h), function(tg) {
    x <- h[[tg]]
    m <- summarise_magnitude(if (!is.null(x)) x$curves else NULL, tg)
    if (nrow(m)) m$form <- form
    m
  }))
}

