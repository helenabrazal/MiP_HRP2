lrt_survreg <- function(reduced, full, label) {
  ll_reduced <- as.numeric(logLik(reduced))
  ll_full    <- as.numeric(logLik(full))
  df_reduced <- attr(logLik(reduced), "df")
  df_full    <- attr(logLik(full), "df")
  
  df_diff <- df_full - df_reduced
  lr_stat <- 2 * (ll_full - ll_reduced)
  p_value <- stats::pchisq(lr_stat, df = df_diff, lower.tail = FALSE)
  
  data.frame(
    interaction = label,
    logLik_reduced = ll_reduced,
    logLik_full = ll_full,
    df_difference = df_diff,
    LR_statistic = lr_stat,
    p_value = p_value,
    significant_0.05 = !is.na(p_value) & p_value < 0.05,
    stringsAsFactors = FALSE
  )
}

make_screen_formula <- function(outcome_t1, outcome_t2, interaction_term, covar_string) {
  rhs <- paste0(interaction_term, " + ", covar_string)
  stats::as.formula(
    paste0("survival::Surv(", outcome_t1, ", ", outcome_t2,
           ", type = 'interval2') ~ ", rhs)
  )
}

