find_segments <- function(x, flag) {
  flag <- as.logical(flag)
  flag[is.na(flag)] <- FALSE
  if (!any(flag)) return(data.frame(start = numeric(0), end = numeric(0)))
  r <- rle(flag)
  ends <- cumsum(r$lengths)
  starts <- ends - r$lengths + 1
  idx_true <- which(r$values)
  data.frame(start = x[starts[idx_true]], end = x[ends[idx_true]])
}

segments_to_string <- function(seg) {
  if (nrow(seg) == 0) return("none")
  paste(sprintf("%g-%g", seg$start, seg$end), collapse = "; ")
}

## one pair per site: primigravidae vs multigravidae
build_within_site_pairs <- function(groups_df,
                                    primi_lvl = "primigravidae",
                                    multi_lvl = "multigravidae") {
  groups_df <- groups_df %>% distinct(gravidity, centro)
  groups_df$gravidity <- as.character(groups_df$gravidity)
  groups_df$centro    <- as.character(groups_df$centro)
  
  sites <- sort(unique(groups_df$centro))
  out <- list(); k <- 1L
  
  for (st in sites) {
    has_p <- any(groups_df$gravidity == primi_lvl & groups_df$centro == st)
    has_m <- any(groups_df$gravidity == multi_lvl & groups_df$centro == st)
    if (!has_p || !has_m) next
    
    out[[k]] <- data.frame(
      g1 = primi_lvl, c1 = st,
      g2 = multi_lvl, c2 = st,
      contrast = paste0("Primi - Multi, ", st),
      stringsAsFactors = FALSE
    )
    k <- k + 1L
  }
  
  if (!length(out)) return(data.frame())
  bind_rows(out) %>% distinct(contrast, .keep_all = TRUE)
}

make_newdata_fixed <- function(model, grav, cent, c_var_name, c_value) {
  
  ## For the LINEAR model, c_log_density is a raw predictor present
  ## in model.frame(). For the SPLINE model, model.frame() holds the
  ## evaluated ns() basis instead, so newdata must be built from the
  ## ORIGINAL variables in the formula, not from model.frame() names.
  ## model.matrix() then re-evaluates ns() using the knots stored in
  ## the terms object.
  
  mf <- model.frame(model)
  tt <- delete.response(stats::terms(model))
  required_vars <- all.vars(tt)
  
  if (!c_var_name %in% required_vars)
    stop("Model formula does not contain predictor: ", c_var_name)
  
  nd <- as.data.frame(
    matrix(NA, nrow = 1, ncol = length(required_vars)),
    stringsAsFactors = FALSE
  )
  names(nd) <- required_vars
  
  nd[[c_var_name]] <- c_value
  if ("gravidity" %in% names(nd)) nd$gravidity <- grav
  if ("centro"    %in% names(nd)) nd$centro    <- cent
  
  for (nm in names(nd)) {
    
    if (nm %in% c(c_var_name, "gravidity", "centro")) next
    
    if (nm %in% names(mf)) {
      x <- mf[[nm]]
      if (is.factor(x)) {
        tab <- table(x); nd[[nm]] <- names(tab)[which.max(tab)]
      } else if (is.numeric(x) || is.integer(x)) {
        nd[[nm]] <- mean(x, na.rm = TRUE)
      } else {
        ok <- which(!is.na(x)); nd[[nm]] <- if (length(ok)) x[ok[1]] else NA
      }
      
    } else if (exists("data", envir = .GlobalEnv) &&
               nm %in% names(get("data", envir = .GlobalEnv))) {
      x <- get("data", envir = .GlobalEnv)[[nm]]
      if (is.factor(x)) {
        tab <- table(x); nd[[nm]] <- names(tab)[which.max(tab)]
      } else if (is.numeric(x) || is.integer(x)) {
        nd[[nm]] <- mean(x, na.rm = TRUE)
      } else {
        ok <- which(!is.na(x)); nd[[nm]] <- if (length(ok)) x[ok[1]] else NA
      }
      
    } else {
      stop("Cannot construct newdata: model requires variable '", nm,
           "' but it is not available in the fitted model frame or `data`.")
    }
  }
  
  xlev <- model$xlevels
  if (!is.null(xlev)) {
    for (nm in intersect(names(xlev), names(nd)))
      nd[[nm]] <- factor(nd[[nm]], levels = xlev[[nm]])
  }
  
  nd
}

contrast_curve_exact <- function(model, raw_grid, mu_log_raw, c_var_name,
                                 g1, c1, g2, c2, alpha = 0.05,
                                 nsim = 5000, seed = 20261002) {
  
  ## ------------------------------------------------------------
  ## SIMULTANEOUS 95% CONFIDENCE BAND
  ##
  ## The contrast is evaluated over the whole qPCR-density grid.
  ## Instead of 200 pointwise 95% CIs, coefficient vectors are drawn
  ## from N(beta_hat, V_hat); for each draw we take the largest
  ## absolute standardized deviation over the ENTIRE curve. The 95th
  ## percentile of those maxima is the critical value for the band.
  ##
  ## This controls the family-wise error rate along the density axis
  ## while preserving the correlation between neighbouring densities,
  ## which a Bonferroni correction over 200 grid points would ignore.
  ## It is reviewer point 5.
  ##
  ## SCOPE: simultaneous ACROSS DENSITIES within one contrast. Across
  ## the three within-site contrasts, the Sidak-adjusted levels table
  ## is the family-wise statement.
  ## ------------------------------------------------------------
  
  u <- usable(model)
  
  if (is.null(u)) {
    out <- data.frame(x_raw = raw_grid, diff = NA_real_, se = NA_real_,
                      lower = NA_real_, upper = NA_real_,
                      sig_pos = FALSE, sig_neg = FALSE)
    return(list(
      curve = out,
      summary = data.frame(
        last_pos_x = NA_real_, first_neg_x = NA_real_,
        seg_pos = NA_character_, seg_neg = NA_character_,
        x_min_used = min(raw_grid), x_max_used = max(raw_grid),
        n_grid = length(raw_grid),
        simultaneous_critical = NA_real_,
        confidence_level = 1 - alpha,
        nsim = nsim,
        note = "No usable non-aliased coefficients/covariance matrix available.")
    ))
  }
  
  tt_noy <- delete.response(terms(model))
  
  Xdiff <- matrix(NA_real_, nrow = length(raw_grid), ncol = length(u$names),
                  dimnames = list(NULL, u$names))
  
  for (i in seq_along(raw_grid)) {
    xc <- log(raw_grid[i]) - mu_log_raw
    
    nd1 <- make_newdata_fixed(model, grav = g1, cent = c1,
                              c_var_name = c_var_name, c_value = xc)
    nd2 <- make_newdata_fixed(model, grav = g2, cent = c2,
                              c_var_name = c_var_name, c_value = xc)
    
    X1 <- tryCatch(model.matrix(tt_noy, nd1), error = function(e) NULL)
    X2 <- tryCatch(model.matrix(tt_noy, nd2), error = function(e) NULL)
    if (is.null(X1) || is.null(X2)) next
    if (!all(u$names %in% colnames(X1)) || !all(u$names %in% colnames(X2))) next
    
    Xdiff[i, ] <- X1[, u$names, drop = FALSE] - X2[, u$names, drop = FALSE]
  }
  
  valid <- apply(Xdiff, 1, function(z) all(is.finite(z)))
  
  if (!any(valid))
    stop("No valid design rows could be constructed for the simultaneous band.")
  
  Xv <- Xdiff[valid, , drop = FALSE]
  x_grid_valid <- raw_grid[valid]
  
  beta_hat <- u$beta
  V_hat    <- u$V
  
  diff_hat <- as.numeric(Xv %*% beta_hat)
  
  ## pointwise SEs standardize the simulated deviations; the band
  ## itself uses the simultaneous critical value, not qnorm(0.975)
  se_diff <- sqrt(pmax(0, rowSums((Xv %*% V_hat) * Xv)))
  
  se_ok <- is.finite(se_diff) & se_diff > 0
  if (!any(se_ok))
    stop("The contrast has no positive finite standard errors; ",
         "cannot construct a simultaneous confidence band.")
  
  set.seed(seed)
  
  beta_sim <- MASS::mvrnorm(n = nsim, mu = beta_hat, Sigma = V_hat,
                            empirical = FALSE)
  
  ## rows = simulations, columns = density grid points
  sim_diff <- beta_sim %*% t(Xv)
  
  z_sim <- sweep(sweep(sim_diff, 2, diff_hat, "-"), 2, se_diff, "/")
  z_sim <- z_sim[, se_ok, drop = FALSE]
  
  max_abs_z <- apply(abs(z_sim), 1, max, na.rm = TRUE)
  
  crit <- as.numeric(stats::quantile(max_abs_z, probs = 1 - alpha,
                                     na.rm = TRUE, names = FALSE))
  
  lower <- diff_hat - crit * se_diff
  upper <- diff_hat + crit * se_diff
  
  out <- data.frame(x_raw = x_grid_valid, diff = diff_hat, se = se_diff,
                    lower = lower, upper = upper) %>%
    mutate(sig_pos = is.finite(lower) & lower > 0,
           sig_neg = is.finite(upper) & upper < 0)
  
  seg_pos <- find_segments(out$x_raw, out$sig_pos)
  seg_neg <- find_segments(out$x_raw, out$sig_neg)
  
  list(
    curve = out,
    summary = data.frame(
      last_pos_x  = if (any(out$sig_pos, na.rm = TRUE)) max(out$x_raw[out$sig_pos], na.rm = TRUE) else NA_real_,
      first_neg_x = if (any(out$sig_neg, na.rm = TRUE)) min(out$x_raw[out$sig_neg], na.rm = TRUE) else NA_real_,
      seg_pos     = segments_to_string(seg_pos),
      seg_neg     = segments_to_string(seg_neg),
      x_min_used  = min(out$x_raw),
      x_max_used  = max(out$x_raw),
      n_grid      = nrow(out),
      simultaneous_critical = crit,
      confidence_level = 1 - alpha,
      nsim = nsim,
      note = "Simultaneous band from parametric MVN coefficient simulation; significance requires the band to exclude zero."
    )
  )
}

make_shade_boundary_labels <- function(df_one_contrast, unit_suffix) {
  df <- df_one_contrast
  if (!nrow(df)) return(NULL)
  
  sp <- df$sig_pos; sp[is.na(sp)] <- FALSE
  sn <- df$sig_neg; sn[is.na(sn)] <- FALSE
  
  seg_pos <- find_segments(df$x_raw, sp)
  seg_neg <- find_segments(df$x_raw, sn)
  
  ymin <- min(c(df$lower, df$diff, 0), na.rm = TRUE)
  ymax <- max(c(df$upper, df$diff, 0), na.rm = TRUE)
  span <- if (is.finite(ymax - ymin) && (ymax - ymin) > 0) (ymax - ymin) else 1
  
  y_top_base <- ymax - 0.08 * span
  y_bot_base <- ymin + 0.08 * span
  step <- 0.14 * span
  
  labfun <- scales::label_number(accuracy = 0.01, big.mark = ",")
  
  build_labels_from_segments <- function(seg, y_base, direction = c("down", "up")) {
    direction <- match.arg(direction)
    if (!nrow(seg)) return(NULL)
    
    labs <- dplyr::bind_rows(
      data.frame(x_raw = seg$start, boundary = "start", stringsAsFactors = FALSE),
      data.frame(x_raw = seg$end,   boundary = "end",   stringsAsFactors = FALSE)
    ) %>%
      dplyr::distinct(x_raw, boundary) %>%
      dplyr::arrange(x_raw, boundary)
    
    if (!nrow(labs)) return(NULL)
    
    labs %>%
      dplyr::mutate(
        idx = dplyr::row_number(),
        y   = if (direction == "down") (y_base - (idx - 1) * step) else (y_base + (idx - 1) * step),
        y   = pmin(pmax(y, ymin + 0.03 * span), ymax - 0.03 * span),
        label = paste0(labfun(x_raw), "\n", unit_suffix),
        hjust = 0.5
      ) %>%
      dplyr::select(x_raw, y, label, hjust)
  }
  
  out_pos <- build_labels_from_segments(seg_pos, y_top_base, direction = "down")
  out_neg <- build_labels_from_segments(seg_neg, y_bot_base, direction = "up")
  
  out <- dplyr::bind_rows(out_pos, out_neg)
  if (is.null(out) || !nrow(out)) return(NULL)
  
  out %>%
    dplyr::mutate(contrast = df$contrast[1]) %>%
    dplyr::select(contrast, x_raw, y, label, hjust)
}

make_log_breaks <- function(x_limits) {
  cand <- c(0.01, 0.1, 1, 10, 100, 1000, 10000, 100000)
  cand[cand >= x_limits[1] & cand <= x_limits[2]]
}

plot_contrast_curves <- function(curves_df, labels_df, title_txt, colour_hex,
                                 x_label, y_expr, x_limits = NULL, x_breaks = NULL) {
  
  if (is.null(labels_df) || !nrow(labels_df) ||
      !("contrast" %in% names(labels_df))) {
    vlines_df <- data.frame(contrast = character(0), x_raw = numeric(0))
    labels_df <- data.frame(
      contrast = character(0), x_raw = numeric(0), y = numeric(0),
      label = character(0), hjust = numeric(0)
    )
  } else {
    vlines_df <- labels_df %>% dplyr::distinct(contrast, x_raw)
  }
  
  g <- ggplot(curves_df, aes(x = x_raw)) +
    geom_ribbon(aes(ymin = lower, ymax = upper), fill = colour_hex, alpha = 0.18, colour = NA) +
    geom_ribbon(data = curves_df %>% dplyr::filter(sig_pos),
                aes(ymin = lower, ymax = upper), fill = colour_hex, alpha = 0.30, colour = NA) +
    geom_ribbon(data = curves_df %>% dplyr::filter(sig_neg),
                aes(ymin = lower, ymax = upper), fill = colour_hex, alpha = 0.30, colour = NA) +
    geom_line(aes(y = diff), colour = colour_hex, linewidth = 1.0) +
    geom_hline(yintercept = 0, linetype = "dashed", linewidth = 0.55) +
    geom_vline(
      data = vlines_df, aes(xintercept = x_raw), inherit.aes = FALSE,
      linetype = "dotted", linewidth = 0.45, colour = "black", alpha = 0.65
    ) +
    geom_text(
      data = labels_df, aes(x = x_raw, y = y, label = label, hjust = hjust),
      inherit.aes = FALSE, size = 4.5, vjust = 0.5, color = "black",
      lineheight = 0.95, check_overlap = FALSE
    ) +
    labs(title = title_txt, x = x_label, y = y_expr) +
    theme_classic(base_size = 13) +
    theme(
      panel.grid.major = element_blank(),
      panel.grid.minor = element_blank(),
      panel.border = element_rect(colour = "black", fill = NA, linewidth = 0.7),
      strip.background = element_rect(fill = "white", colour = "black", linewidth = 0.7),
      strip.text = element_text(face = "bold", size = 12, color = "black"),
      plot.title = element_text(face = "bold", size = 14.5, color = "black", lineheight = 1.05),
      axis.title = element_text(size = 13, color = "black"),
      axis.text = element_text(size = 10.8, color = "black"),
      plot.margin = margin(10, 12, 10, 10)
    )
  
  if (!is.null(x_limits)) {
    g <- g + scale_x_log10(
      limits = x_limits, breaks = x_breaks,
      labels = scales::label_number(accuracy = 0.01, big.mark = ",")
    )
  } else {
    g <- g + scale_x_log10(labels = scales::label_number(accuracy = 0.01, big.mark = ","))
  }
  
  g
}

safe_ggsave <- function(filename, plot, width, height, dpi = NULL, device = NULL) {
  args <- list(filename = filename, plot = plot, width = width, height = height)
  if (!is.null(dpi)) args$dpi <- dpi
  if (!is.null(device)) args$device <- device
  
  ok <- tryCatch({ do.call(ggplot2::ggsave, args); TRUE },
                 error = function(e) {
                   message("Could not save '", filename, "': ", conditionMessage(e))
                   FALSE })
  if (ok) return(filename)
  
  ext <- tools::file_ext(filename)
  stem <- tools::file_path_sans_ext(filename)
  fallback <- paste0(stem, "_", format(Sys.time(), "%Y%m%d_%H%M%S"), ".", ext)
  
  ok2 <- tryCatch({ do.call(ggplot2::ggsave, modifyList(args, list(filename = fallback))); TRUE },
                  error = function(e) {
                    message("Fallback save also failed for '", fallback, "': ",
                            conditionMessage(e))
                    FALSE })
  if (ok2) { message("Saved fallback file: ", fallback); return(fallback) }
  NA_character_
}

run_hasta_desde_within_site <- function(model_obj,
                                        marker_tag,
                                        colour_hex,
                                        y_expr,
                                        unit_suffix,
                                        common_c_low = COMMON_C_LOW,
                                        common_c_high = COMMON_C_HIGH,
                                        x_limits_shared = NULL,
                                        x_breaks_shared = NULL) {
  cat("\n======== Density ranges where the SIMULTANEOUS 95% band",
      "excludes zero, within site:", marker_tag, "========\n")
  
  mf_used <- model.frame(model_obj)
  mu_logdens_center <- MU_LOG_DENSITY
  
  if (is.finite(common_c_low) && is.finite(common_c_high) && common_c_low < common_c_high) {
    x_min <- pmax(exp(common_c_low  + mu_logdens_center), 1e-8)
    x_max <- pmax(exp(common_c_high + mu_logdens_center), 1e-8)
  } else {
    raw_vec <- data$density
    raw_vec <- raw_vec[is.finite(raw_vec) & !is.na(raw_vec) & raw_vec > 0]
    x_min <- as.numeric(quantile(raw_vec, 0.01, na.rm = TRUE))
    x_max <- as.numeric(quantile(raw_vec, 0.99, na.rm = TRUE))
  }
  
  if (!is.finite(x_min) || !is.finite(x_max) || x_min >= x_max) {
    cat("WARNING: invalid density grid bounds; skipping.\n")
    return(invisible(NULL))
  }
  
  x_grid <- exp(seq(log(x_min), log(x_max), length.out = 200))
  
  groups <- mf_used %>% distinct(gravidity, centro)
  pairs_df <- build_within_site_pairs(groups)
  if (!nrow(pairs_df)) {
    cat("WARNING: no site has both gravidity groups; skipping.\n")
    return(invisible(NULL))
  }
  pairs_df$contrast <- clean_text(pairs_df$contrast)
  
  cat("Grid:", signif(min(x_grid), 4), "to", signif(max(x_grid), 4), "(n=200)\n")
  cat("Within-site contrasts:", nrow(pairs_df), "\n")
  
  res_list <- lapply(seq_len(nrow(pairs_df)), function(ii) {
    rr <- contrast_curve_exact(
      model      = model_obj,
      raw_grid   = x_grid,
      mu_log_raw = mu_logdens_center,
      c_var_name = "c_log_density",
      g1 = pairs_df$g1[ii], c1 = pairs_df$c1[ii],
      g2 = pairs_df$g2[ii], c2 = pairs_df$c2[ii]
    )
    list(curve   = rr$curve   %>% mutate(contrast = pairs_df$contrast[ii]),
         summary = rr$summary %>% mutate(contrast = pairs_df$contrast[ii]))
  })
  
  curves_all <- bind_rows(lapply(res_list, `[[`, "curve"))
  summ_all   <- bind_rows(lapply(res_list, `[[`, "summary"))
  
  n_fin <- sum(is.finite(curves_all$diff))
  cat("Finite contrast values:", n_fin, "of", nrow(curves_all), "\n")
  if (n_fin == 0) {
    warning("All contrasts are NA for ", marker_tag,
            ". Check for aliased coefficients above.")
    return(invisible(NULL))
  }
  
  curves_all <- curves_all %>% mutate(contrast = clean_text(contrast))
  summ_all   <- summ_all %>%
    mutate(contrast = clean_text(contrast),
           seg_pos  = clean_text(seg_pos),
           seg_neg  = clean_text(seg_neg),
           note     = clean_text(note))
  
  curves_file <- paste0("WITHIN_CURVES_", marker_tag, "_hasta_desde_SIMULTANEOUS95CI.csv")
  summ_file   <- paste0("WITHIN_SUMMARY_", marker_tag, "_hasta_desde_SIMULTANEOUS95CI.csv")
  write_csv_utf8_bom(curves_all, curves_file)
  write_csv_utf8_bom(summ_all,   summ_file)
  
  cat("Saved (UTF-8 BOM):\n  -", curves_file, "\n  -", summ_file, "\n")
  
  labels_all <- bind_rows(
    lapply(split(curves_all, curves_all$contrast),
           make_shade_boundary_labels, unit_suffix = unit_suffix)
  )
  
  ## with no significant segment anywhere, bind_rows of NULLs gives a
  ## 0 x 0 tibble and the filter below would fail on a missing column
  if (is.null(labels_all) || !nrow(labels_all) ||
      !("contrast" %in% names(labels_all))) {
    labels_all <- data.frame(
      contrast = character(0), x_raw = numeric(0),
      y = numeric(0), label = character(0), hjust = numeric(0)
    )
  }
  
  cat("\n---- Ranges where the simultaneous band excludes zero ----\n")
  print(as.data.frame(summ_all %>%
                        select(contrast, seg_pos, seg_neg, simultaneous_critical)))
  cat("\nsimultaneous_critical is the multiplier replacing 1.96. It is\n")
  cat("larger because the band must hold across all 200 densities at\n")
  cat("once. A range reported here survives multiplicity (point 5).\n")
  
  ## every contrast is shown; there are only three
  curves_plot <- curves_all %>%
    mutate(contrast = factor(contrast, levels = sort(unique(contrast))))
  
  labels_plot <- if (nrow(labels_all))
    labels_all %>% mutate(contrast = factor(contrast,
                                            levels = levels(curves_plot$contrast))) else NULL
  
  title_clean <- paste0(
    "Primigravidae vs multigravidae in ", marker_tag,
    "\nat matched qPCR density, within each site",
    "\n(simultaneous 95% confidence band)"
  )
  
  p_all <- plot_contrast_curves(
    curves_plot, labels_plot,
    title_txt  = title_clean,
    colour_hex = colour_hex,
    x_label    = "qPCR parasite density (parasites/µL; log scale)",
    y_expr     = y_expr,
    x_limits   = x_limits_shared,
    x_breaks   = x_breaks_shared
  ) +
    facet_wrap(~ contrast, ncol = 3, scales = "free_y")
  
  cat("\n--- Printing HASTA/DESDE plot:", marker_tag, "---\n")
  print(p_all)
  
  out_png <- paste0("WITHIN_HASTA_DESDE_", marker_tag, "_SIMULTANEOUS95CI.png")
  out_pdf <- paste0("WITHIN_HASTA_DESDE_", marker_tag, "_SIMULTANEOUS95CI.pdf")
  
  saved_png <- safe_ggsave(out_png, p_all, width = 15, height = 5.5, dpi = 700)
  saved_pdf <- safe_ggsave(out_pdf, p_all, width = 15, height = 5.5,
                           device = grDevices::cairo_pdf)
  
  cat("Saved:\n  -", saved_png, "\n  -", saved_pdf, "\n")
  
  invisible(list(curves = curves_all, summary = summ_all,
                 labels = labels_all, plot = p_all))
}

