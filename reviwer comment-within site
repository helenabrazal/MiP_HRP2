## 1b) BUILD THE CENSORED OUTCOMES
##
## A concentration is unusable for one of two reasons, and they are
## not the same thing:
##   below the LLOQ  -> informative, the value lies in (0, LLOQ)
##   never assayed   -> no information, the row must be dropped
## The detection column tells them apart: it is non-missing for any
## well that produced a reading.
## ============================================================
make_interval <- function(conc, assayed, saturated, detection, lloq, uloq = NA_real_) {
  n  <- length(conc)
  t1 <- rep(NA_real_, n)
  t2 <- rep(NA_real_, n)
  
  detection <- tolower(trimws(as.character(detection)))
  
  ## Left-censor anything known to be below the LLOQ. Non-detected
  ## samples are below the LLOD and therefore necessarily below the
  ## LLOQ; numerical sub-LLOQ concentrations are censored too, since
  ## below that limit the interpolated value is blank noise pushed
  ## through the standard curve.
  below <- assayed & !saturated & (
    detection == "non detected" |
      (!is.na(conc) & is.finite(conc) & conc < lloq)
  )
  ## an exact observation needs a usable value, so a stray NA can
  ## never be read as a measurement
  quantified <- assayed & !saturated & !below & !is.na(conc) & is.finite(conc)
  above      <- assayed & saturated
  
  t1[quantified] <- log1p(conc[quantified])
  t2[quantified] <- log1p(conc[quantified])
  
  t1[below] <- NA_real_
  t2[below] <- log1p(lloq)
  
  if (is.finite(uloq)) {
    t1[above] <- log1p(uloq)
    t2[above] <- NA_real_
  }
  
  status <- dplyr::case_when(
    !assayed   ~ "not_assayed",
    below      ~ "left_censored",
    above      ~ "right_censored",
    quantified ~ "exact",
    TRUE       ~ "unusable"
  )
  
  list(t1 = t1, t2 = t2, status = status)
}

