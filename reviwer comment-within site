## ============================================================
## 0) Robust model helpers
## ============================================================
usable <- function(model) {
  if (is.null(model)) return(NULL)
  
  beta <- tryCatch(stats::coef(model), error = function(e) NULL)
  V <- tryCatch(stats::vcov(model), error = function(e) NULL)
  
  if (is.null(beta) || is.null(V) || length(beta) == 0) return(NULL)
  
  keep <- is.finite(beta) & names(beta) %in% rownames(V)
  if (!any(keep)) return(NULL)
  
  nm <- names(beta)[keep]
  beta2 <- beta[keep]
  V2 <- V[nm, nm, drop = FALSE]
  
  if (any(!is.finite(beta2)) || any(!is.finite(V2))) {
    keep2 <- is.finite(beta2) & vapply(
      seq_along(beta2),
      function(i) all(is.finite(V2[i, ])) && all(is.finite(V2[, i])),
      logical(1)
    )
    if (!any(keep2)) return(NULL)
    nm <- nm[keep2]
    beta2 <- beta2[keep2]
    V2 <- V2[nm, nm, drop = FALSE]
  }
  
  list(beta = beta2, V = V2, names = nm)
}

