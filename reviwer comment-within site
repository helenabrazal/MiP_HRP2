trapz <- function(x, y) {
  ok <- is.finite(x) & is.finite(y) & !is.na(x) & !is.na(y)
  x <- x[ok]; y <- y[ok]
  if (length(x) < 2) return(NA_real_)
  o <- order(x); x <- x[o]; y <- y[o]
  sum((y[-1] + y[-length(y)]) / 2 * diff(x))
}

add_segment_id <- function(flag) {
  flag <- as.logical(flag)
  flag[is.na(flag)] <- FALSE
  r <- rle(flag)
  seg_id <- rep(NA_integer_, length(flag))
  idx_end <- cumsum(r$lengths)
  idx_start <- idx_end - r$lengths + 1
  k <- 0L
  for (i in seq_along(r$values)) {
    if (isTRUE(r$values[i])) {
      k <- k + 1L
      seg_id[idx_start[i]:idx_end[i]] <- k
    }
  }
  seg_id
}

summarise_magnitude_from_curves <- function(curves_df, marker_tag) {
  if (is.null(curves_df) || !nrow(curves_df)) return(tibble::tibble())
  
  df <- curves_df %>%
    dplyr::mutate(
      marker   = marker_tag,
      contrast = clean_text(.data$contrast),
      x_raw    = as.numeric(.data$x_raw),
      diff     = as.numeric(.data$diff),
      sig_pos  = as.logical(.data$sig_pos),
      sig_neg  = as.logical(.data$sig_neg)
    ) %>%
    dplyr::filter(is.finite(x_raw), x_raw > 0) %>%
    dplyr::arrange(contrast, x_raw)
  
  if (!nrow(df)) return(tibble::tibble())
  
  one <- function(dsub, key, flag_col, dir) {
    dsub <- dsub %>%
      dplyr::arrange(x_raw) %>%
      dplyr::mutate(
        flag = as.logical(.data[[flag_col]]),
        log10x = log10(x_raw),
        ratio_1p = exp(diff),
        pct_1p   = (exp(diff) - 1) * 100
      )
    dsub$flag[is.na(dsub$flag)] <- FALSE
    if (!any(dsub$flag)) return(tibble::tibble())
    
    dsub <- dsub %>% dplyr::mutate(seg_id = add_segment_id(flag))
    
    core <- function(d) {
      w <- max(d$log10x) - min(d$log10x)
      tibble::tibble(
        n_points = nrow(d),
        density_min = min(d$x_raw), density_max = max(d$x_raw),
        log10_range = w,
        mean_diff_log1p = mean(d$diff), median_diff_log1p = stats::median(d$diff),
        mean_ratio_1p = mean(d$ratio_1p), median_ratio_1p = stats::median(d$ratio_1p),
        mean_pct_1p = mean(d$pct_1p), median_pct_1p = stats::median(d$pct_1p),
        avg_diff_log1p_per_log10 = if (is.finite(w) && w > 0) trapz(d$log10x, d$diff)/w else NA_real_,
        avg_pct_1p_per_log10     = if (is.finite(w) && w > 0) trapz(d$log10x, d$pct_1p)/w else NA_real_
      )
    }
    
    overall <- dsub %>% dplyr::filter(flag) %>% core() %>%
      dplyr::mutate(marker = marker_tag, contrast = key, direction = dir,
                    level = "overall", seg_id = NA_integer_)
    
    segs <- dsub %>% dplyr::filter(!is.na(seg_id)) %>% split(.$seg_id) %>%
      lapply(function(d) core(d) %>% dplyr::mutate(seg_id = d$seg_id[1])) %>%
      dplyr::bind_rows()
    if (nrow(segs)) segs <- segs %>%
      dplyr::mutate(marker = marker_tag, contrast = key, direction = dir, level = "segment")
    
    dplyr::bind_rows(overall, segs)
  }
  
  spl <- split(df, df$contrast, drop = TRUE)
  res <- lapply(names(spl), function(cc)
    dplyr::bind_rows(one(spl[[cc]], cc, "sig_pos", "sig_pos"),
                     one(spl[[cc]], cc, "sig_neg", "sig_neg"))) %>%
    dplyr::bind_rows()
  
  if (!nrow(res) || !("marker" %in% names(res))) {
    cat("  (", marker_tag, ": no significant interval in any contrast)\n", sep = "")
    return(tibble::tibble())
  }
  
  res %>%
    dplyr::mutate(direction = factor(direction, levels = c("sig_pos","sig_neg"))) %>%
    dplyr::select(marker, contrast, direction, level, seg_id, dplyr::everything())
}

