fmt_p <- function(p, lbl) {
  base <- ifelse(is.na(p), paste0(lbl, " p = NA"), sprintf("%s p = %.3f", lbl, p))
  ifelse(!is.na(p) & p < 0.05, paste0("<b>", base, "</b>"), base)
}

make_panel_forest <- function(df, title, colour_hex, show_y_labels = TRUE, ylim_max = NULL,
                              p_label_size = 3.8, right_margin = 70) {
  g <- ggplot(df, aes(x = contrast, y = estimate)) +
    geom_hline(yintercept = 0, linetype = "dashed", linewidth = 0.55) +
    geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL), width = 0.24,
                  linewidth = 0.9, color = colour_hex) +
    geom_point(shape = 22, size = 4.5, stroke = 1.0, fill = colour_hex, color = "black") +
    ggtext::geom_richtext(
      aes(y = label_y, label = p_label),
      hjust = 0, size = p_label_size, fill = "white",
      label.color = "black", color = "black",
      label.padding = grid::unit(c(0.13, 0.16, 0.13, 0.16), "lines"),
      label.r = grid::unit(0.08, "lines")
    ) +
    coord_flip(clip = "off") +
    labs(title = title, x = NULL, y = NULL) +
    theme_classic(base_size = 13) +
    theme(
      panel.grid.major = element_blank(),
      panel.grid.minor = element_blank(),
      panel.border = element_rect(colour = "black", fill = NA, linewidth = 0.85),
      axis.text.y = element_text(color = "black", size = 11.5),
      axis.text.x = element_text(color = "black", size = 11),
      plot.title  = element_text(face = "bold", size = 13.8, color = "black"),
      plot.margin = margin(10, right_margin, 10, 10)
    )
  
  if (!is.null(ylim_max))
    g <- g + scale_y_continuous(limits = c(-ylim_max, ylim_max),
                                expand = expansion(mult = c(0.04, 0.16)))
  if (!show_y_labels)
    g <- g + theme(axis.text.y = element_blank(), axis.ticks.y = element_blank())
  g
}

prep_forest_df <- function(df_in) {
